# たより — 環境設定のひな形
# 使い方：このファイルを「.env」という名前でコピーし、値を自分のものに置き換える。
#   cp .env.example .env
# .env は .gitignore 済みなので GitHub には上がりません。
# アプリ起動時（run.py / gunicorn どちらでも）に自動で読み込まれます。

# --- AIの「過去の自分」対話を有効にするのに必須の2つ ---
# ① 外部通信をONにする（これが無いとAIは一切呼ばれず定型文になる）
TAYORI_ENABLE_NETWORK=1

GEMINI_API_KEY=ここに自分の鍵を貼る（AIzaSy… または AQ.… で始まる）

# --- 任意 ---
# 使うGeminiモデル（未指定なら gemini-2.0-flash）。404が出るときはここを変える
# TAYORI_GEMINI_MODEL=gemini-2.0-flash
# Geminiの代わりに Anthropic Claude（有料）を使う場合だけ設定
# ANTHROPIC_API_KEY=sk-ant-...

# --- 課金（Stripe・収益モデル v1）。設定しなくてもアプリは動く（決済APIが503を返すだけ） ---
# ダッシュボード（テストモード）の「開発者 > APIキー」から取る（sk_test_... / pk_test_...）
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook の署名シークレット（stripe listen で出る whsec_... か、本番はダッシュボードのWebhook設定画面）
# STRIPE_WEBHOOK_SECRET=whsec_...
# 商品(Product)ごとに作った価格(Price)のid。ダッシュボードの「商品」から作って貼る（price_...）
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
# STRIPE_PRICE_SUPPORTER_MONTHLY=price_...
# STRIPE_PRICE_SUPPORTER_YEARLY=price_...
